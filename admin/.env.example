# Copy to admin/.env and fill in — never commit real values.

# Supabase project URL (same as app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# ANON key — safe to expose in client-side code, same key the Android app uses.
# Get from: Supabase Dashboard -> Project Settings -> API -> anon public key
#
# Do NOT put the service_role key here or anywhere prefixed VITE_. Vite inlines
# VITE_-prefixed vars into the public JS bundle, so a service_role key here would
# be extractable by anyone who opens dev tools on the deployed dashboard. Access
# control comes from real Supabase Auth login + the admin RLS policies in
# supabase/migrations/003_admin_rls.sql, not from which key is used.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
