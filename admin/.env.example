# Copy to admin/.env and fill in — never commit real values.

# Supabase project URL (same as app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# SERVICE ROLE key — only for admin dashboard, never expose in the Android app
# Get from: Supabase Dashboard → Project Settings → API → service_role key
VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
